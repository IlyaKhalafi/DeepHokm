# DeepHokm configuration. Copy to .env and edit per machine; .env is never
# committed. Every comment sits on its own line: the Makefile reads this file
# with `-include`, and GNU Make keeps the whitespace between a value and a
# trailing comment, which would silently pad the value.

# GPU device used by compose / docker run.
DEEPHOKM_GPU_DEVICE_ID=0

# Web UI listen port.
DEEPHOKM_PORT=8025

# Policy served by the web UI. Use ``greedy`` to test the deterministic
# public-information heuristic; any other value serves the network below.
DEEPHOKM_POLICY=network

# Fast-mode Q-pure weights (repo-relative), baked into the Docker image.
DEEPHOKM_QNET=checkpoints/qnet_numpy_full.npz

# Hard-mode Q-hybrid weights (repo-relative). This distinct network was
# trained from K=6144 teacher labels; its feature contract records and checks
# that provenance at startup.
DEEPHOKM_HARD_QNET=checkpoints/qhybrid_k6144.npz
DEEPHOKM_HARD_QNET_CONTRACT=checkpoints/qhybrid_k6144.features.json

# Fallback MaskablePPO checkpoint, only reached if DEEPHOKM_QNET is missing.
# Plateaued at the level of a greedy clone; not baked into the Docker image.
DEEPHOKM_MODEL=checkpoints/final.zip

# Determinized worlds sampled live per Hard-mode decision. This is not the
# K=6144 teacher budget used to train the Hard network. Fast always serves
# Q-pure without search; Hard adds search over this many sampled worlds.
DEEPHOKM_HARD_SEARCH_K=384

# Parallel scorer processes for Hard-mode search decisions.
# The rollouts are pure Python, so a large Hard budget stays interactive
# only with this. Capped at the machine's core count.
DEEPHOKM_SEARCH_WORKERS=1

# Fast and Hard weights mounted read-only over the baked archives at run time.
# Relative paths resolve against the compose file's directory.
DEEPHOKM_MODEL_PATH=./checkpoints/qnet_numpy_full.npz
DEEPHOKM_HARD_MODEL_PATH=./checkpoints/qhybrid_k6144.npz
DEEPHOKM_HARD_MODEL_CONTRACT_PATH=./checkpoints/qhybrid_k6144.features.json

# Serve random opponents instead of failing when no checkpoint is present.
# Set to 1 only for a UI demo without a trained model.
DEEPHOKM_ALLOW_RANDOM_MODEL=0

# Visual QA reviewer endpoint (OpenAI-compatible chat completions).
DEEPHOKM_VLM_BASE_URL=http://localhost:8024/v1

# Visual QA reviewer model name.
DEEPHOKM_VLM_MODEL=Qwen/Qwen3.8-27B-FP8

# Web UI base URL used by the Playwright smoke test and the visual QA harness.
DEEPHOKM_BASE_URL=http://127.0.0.1:8025

# Optional: CUDA forward-compatibility libraries, prepended to LD_LIBRARY_PATH.
# DEEPHOKM_CUDA_COMPAT_PATH=/usr/local/cuda/compat
