# DeepHokm configuration. Copy to .env and edit per machine; .env is never committed.

DEEPHOKM_GPU_DEVICE_ID=0                            # GPU device used by compose / docker run
DEEPHOKM_PORT=8025                                  # web UI listen port
DEEPHOKM_MODEL=checkpoints/final.zip                # served checkpoint (host path for mount)
DEEPHOKM_VLM_BASE_URL=http://localhost:8024/v1      # visual QA reviewer endpoint
DEEPHOKM_VLM_MODEL=Qwen/Qwen3.8-27B-FP8             # visual QA reviewer model name
# DEEPHOKM_CUDA_COMPAT_PATH=/raid/ilya/cuda-compat-13.0  # optional: CUDA forward-compat libs
